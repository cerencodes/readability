  web.trends.businessclass2,
  fallback_related_queries
)
webtrends2.filtered <- webtrends2 %>% filter(keyword != "Emirates Business Class")
webtrends.total <- bind_rows(webtrends1, webtrends2.filtered)

if (nrow(webtrends.total) == 0 && exists("cached_related_queries")) {
  webtrends.total <- cached_related_queries
}

save_trends_csv_cache(web.trends.businessclass, web.trends.businessclass2, webtrends.total)

glimpse(webtrends.total)
```

::: {.callout-tip}
## Interpretation guide
Google Trends reports indexed search interest rather than raw search counts. A value of `100` marks the peak interest within the selected comparison set and time window.
