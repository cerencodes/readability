safe_gtrends <- function(...) {
  tryCatch(
    gtrends(...),
    error = function(e) {
      warning(sprintf("Google Trends request failed: %s", conditionMessage(e)))
      NULL
    }
  )
}

safe_read_html <- function(url, attempts = 3, pause_seconds = 2) {
  for (attempt in seq_len(attempts)) {
    page <- tryCatch(
      read_html(url),
      error = function(e) NULL
    )

    if (!is.null(page)) {
      return(page)
    }

    if (attempt < attempts) {
      Sys.sleep(pause_seconds)
    }
  }

  NULL
}

safe_gtrends_retry <- function(..., attempts = 3, pause_seconds = 3) {
  for (attempt in seq_len(attempts)) {
    result <- safe_gtrends(...)

    if (!is.null(result)) {
      return(result)
    }

    if (attempt < attempts) {
      Sys.sleep(pause_seconds)
    }
  }

  NULL
}

save_trends_cache <- function(reference_obj, comparison_obj, cache_file = trends_cache_file) {
  if (!is.null(reference_obj) || !is.null(comparison_obj)) {
    web.trends.businessclass <- reference_obj
    web.trends.businessclass2 <- comparison_obj
    save(web.trends.businessclass, web.trends.businessclass2, file = cache_file)
  }
}

extract_interest_over_time <- function(trends_obj) {
  if (is.null(trends_obj)) {
    return(tibble())
  }

  interest <- trends_obj[["interest_over_time"]]

  if (is.null(interest)) {
    tibble()
  } else {
    as_tibble(interest)
  }
}

save_trends_csv_cache <- function(reference_obj, comparison_obj, related_queries_df) {
  reference_df <- extract_interest_over_time(reference_obj)
  comparison_df <- extract_interest_over_time(comparison_obj)

  if (nrow(reference_df) > 0) {
    readr::write_csv(reference_df, trends_reference_csv)
  }

  if (nrow(comparison_df) > 0) {
    readr::write_csv(comparison_df, trends_comparison_csv)
  }

  if (!is.null(related_queries_df) && nrow(related_queries_df) > 0) {
    readr::write_csv(related_queries_df, trends_related_csv)
  }
}

plot_gtrends_or_message <- function(trends_obj, fallback_data = NULL, message = "Google Trends data unavailable for this plot") {
  if (is.null(trends_obj)) {
    if (is.null(fallback_data) || nrow(fallback_data) == 0) {
      plot.new()
      text(0.5, 0.5, message)
    } else {
      ggplot(fallback_data, aes(x = date, y = hits, color = keyword)) +
        geom_line(linewidth = 1) +
        geom_point(size = 2) +
        labs(
          x = "Date",
          y = "Indexed Search Interest",
          color = "Keyword",
          title = "Google Trends Search Interest"
        ) +
        theme_minimal()
    }
  } else {
    plot(trends_obj)
  }
}

summarize_gtrends_or_message <- function(trends_obj, fallback_data = NULL) {
  if (is.null(trends_obj)) {
    if (is.null(fallback_data) || nrow(fallback_data) == 0) {
      message("Google Trends data unavailable for this summary")
    } else {
      fallback_data %>%
        group_by(keyword) %>%
        summarise(
          observations = n(),
          min_hits = min(hits),
          max_hits = max(hits),
          avg_hits = round(mean(hits), 1),
          .groups = "drop"
        )
    }
  } else {
    summary(trends_obj)
  }
}

get_related_queries <- function(trends_obj, fallback_queries = NULL) {
  related <- trends_obj[["related_queries"]]

  if (is.null(related)) {
    if (is.null(fallback_queries)) {
      tibble(keyword = character(), value = character())
    } else {
      fallback_queries
    }
  } else {
    as_tibble(related)
  }
}
```

::: {.callout-note}
## Why the code is defensive
Google Trends requests can fail or return incomplete sections. The helper functions above allow the document to render more gracefully when the API is unavailable.
